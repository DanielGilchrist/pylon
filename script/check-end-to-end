#!/bin/bash
# Drives the real binaries over a stand-in for ssh. Catches failures that
# in-process specs cannot, because the server runs as a separate process.
set -euo pipefail

cd "$(dirname "$0")/.."
PYLON="$PWD/bin/pylon"

[[ -x "$PYLON" ]] || { echo "build first: crystal build --release -o bin/pylon src/pylon.cr"; exit 1; }

WORK="$(mktemp -d)"
cleanup() {
  kill "${PID:-0}" 2>/dev/null || true
  for _ in $(seq 1 50); do
    kill -0 "${PID:-0}" 2>/dev/null || break
    sleep 0.1
  done
  kill -9 "${PID:-0}" 2>/dev/null || true
  rm -rf "$WORK"
}
trap cleanup EXIT

mkdir -p "$WORK"/{a,b,stub}
printf '#!/bin/sh\neval "$(eval echo \\${$#})"\n' > "$WORK/stub/ssh"
chmod +x "$WORK/stub/ssh"
export PATH="$WORK/stub:$PATH"

mkdir -p "$WORK/a/app/models" "$WORK/a/db"
for i in $(seq 1 400); do echo "class F$i; end" > "$WORK/a/app/models/f$i.rb"; done
echo "-- schema" > "$WORK/a/db/structure.sql"
echo "stale" > "$WORK/b/old.rb"

failures=0
check() {
  local what="$1" expected="$2" actual="$3"
  if [[ "$expected" == "$actual" ]]; then
    echo "  ok    $what"
  else
    echo "  FAIL  $what: expected $expected, got $actual"
    failures=$((failures + 1))
  fi
}

files_in() {
  find "$1" -type f | wc -l | tr -d ' '
}

files_are() {
  [[ "$(files_in "$1")" == "$2" ]]
}

wait_until() {
  local what="$1"
  shift
  local deadline=$(( $(date +%s) + 30 ))

  until "$@"; do
    if [[ "$(date +%s)" -ge "$deadline" ]]; then
      echo "  FAIL  timed out waiting for $what"
      failures=$((failures + 1))
      return 0
    fi

    sleep 0.05
  done
}

"$PYLON" sync "$WORK/a" "user@host:$WORK/b" --state "$WORK/state" --watch --brand "Test Sync" \
  --remote-binary "$PYLON" --remote-state "$WORK/rstate" > "$WORK/log" 2>&1 &
PID=$!
disown 2>/dev/null || true

wait_until "the first sync to finish" grep -q "watching for changes" "$WORK/log"

check "initial push landed"        401 "$(files_in "$WORK/b")"
check "local tree intact"          401 "$(files_in "$WORK/a")"
check "box only file removed"      0   "$(find "$WORK/b" -name old.rb | wc -l | tr -d ' ')"
check "runs under the given brand" yes "$(grep -q 'Test Sync' "$WORK/log" && echo yes || echo no)"

echo "class New; end" > "$WORK/a/app/models/new_model.rb"
wait_until "the local add to reach the box" test -f "$WORK/b/app/models/new_model.rb"
check "local add went up"          402 "$(files_in "$WORK/b")"
check "local still intact"         402 "$(files_in "$WORK/a")"

echo "generated" > "$WORK/b/from_box.rbi"
wait_until "the box add to come down" test -f "$WORK/a/from_box.rbi"
check "box add came down"          403 "$(files_in "$WORK/a")"

wait_until "the box to settle" files_are "$WORK/b" 403
check "nothing drifted"            403 "$(files_in "$WORK/b")"

if grep -q "halted" "$WORK/log"; then
  echo "  FAIL  a cycle halted"
  failures=$((failures + 1))
fi

if [[ "$failures" -gt 0 ]]; then
  echo
  echo "pylon log:"; sed 's/^/    /' "$WORK/log"
  exit 1
fi

echo "end to end ok"
